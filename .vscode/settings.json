{
  // Global editor / workspace
  // "vscode_custom_css.imports": [
  //   "file:///Users/2mc-oo/Projects/cursor-extentions/toggle-indent-guides/toggle-indent-guides/qqq2.js",
  // ],
  "editor.hover.enabled": true,
  // "editor.multiCursorModifier": "alt",
  "editor.hover.delay": 500,
  "editor.hover.sticky": true,
  "editor.hover.above": true,
  "editor.hover.hidingDelay": 50,
  //////////////////////
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true
  },
  "files.associations": {
    "*.graphql": "graphql"
  },
  "[graphql]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "apollographql.vscode-apollo"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.languageServer": "None",
  // BasedPyright extension: type-check rules in pyproject.toml [tool.basedpyright]
  "basedpyright.analysis.autoFormatStrings": true,
  "basedpyright.analysis.autoImportCompletions": true,
  "basedpyright.analysis.autoSearchPaths": true,
  "basedpyright.analysis.diagnosticMode": "workspace",
  "basedpyright.analysis.inlayHints.callArgumentNames": true,
  "basedpyright.analysis.inlayHints.callArgumentNamesMatching": true,
  "basedpyright.analysis.inlayHints.functionReturnTypes": true,
  "basedpyright.analysis.inlayHints.genericTypes": true,
  "basedpyright.analysis.inlayHints.variableTypes": true,
  "basedpyright.analysis.logLevel": "Information",
  "basedpyright.analysis.typeshedPaths": [],
  "basedpyright.analysis.useTypingExtensions": false,
  "basedpyright.importStrategy": "fromEnvironment",
  // Python extension (pytest)
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  // Panel / debug: keep Terminal & other tabs visible (avoid Debug Console header overflow)
  "workbench.panel.showLabels": false,
  "workbench.panel.opensMaximized": "never",
  "debug.toolBarLocation": "docked",
  "debug.internalConsoleOptions": "neverOpen",
  "debug.openDebug": "neverOpen",
  "debug.focusConsoleOnBreak": false,
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": "always",
  "workbench.tree.renderIndentGuides": "always",
  "workbench.colorCustomizations": {
    "editorUnnecessaryCode.opacity": "#b4b4b4a0",
    "tree.indentGuidesStroke": "#88C0D0AA",
    "tree.inactiveIndentGuidesStroke": "#E4E4E420",
    "editorIndentGuide.activeBackground1": "#88C0D0AA",
    "editorIndentGuide.activeBackground2": "#88C0D0AA",
    "editorIndentGuide.activeBackground3": "#88C0D0AA",
    "editorIndentGuide.activeBackground4": "#88C0D0AA",
    "editorIndentGuide.activeBackground5": "#88C0D0AA",
    "editorIndentGuide.activeBackground6": "#88C0D0AA"
  }
}